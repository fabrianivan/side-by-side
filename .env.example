# Database (SQLite default for zero-config single-node setup; switch provider in prisma/schema.prisma to "postgresql" for multi-instance production)
DATABASE_URL="file:./dev.db"
# PostgreSQL production example:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/side_by_side?schema=public"

# Backend Server & Security Configuration
PORT=3001
HOST="0.0.0.0"
SESSION_SECRET="side-by-side-dev-secret-change-in-production-32chars"
ENCRYPTION_KEY="side-by-side-dev-encryption-key-change-in-production-32bytes"
CORS_ORIGIN="http://localhost:5173"

# Healthcare Provider (Nakes) Registration Invite Code
# Required when creating a Healthcare Provider account via UI or API
NAKES_INVITE_CODE="SBS-CLINIC-DEV-2026"

# Frontend Vite Configuration
VITE_API_URL="/api"
VITE_APP_NAME="Side by Side"

# AI features (optional, opt-in for users). Without a key, AI features hide themselves.
# Anthropic Claude (default provider)
ANTHROPIC_API_KEY=""
# AI_MODEL="claude-sonnet-5-5"        # companion, lab reader, plan explainer, visit brief
# AI_FAST_MODEL="claude-haiku-5-5"    # distress check
# Or any OpenAI-compatible endpoint (e.g. Azure OpenAI):
# AI_PROVIDER="openai-compatible"
# AI_BASE_URL="https://<resource>.openai.azure.com/openai/deployments/<deployment>?api-version=2024-10-21"
# AI_API_KEY=""
# AI_AUTH_HEADER="api-key"
# AI_MODEL="<deployment-or-model>"
# AI_DISABLED="true"                  # switch all AI features off

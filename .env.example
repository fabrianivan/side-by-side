# Database (SQLite default untuk kemudahan demo lokal; gunakan URL postgresql:// untuk produksi)
DATABASE_URL="file:./dev.db"
# Contoh PostgreSQL untuk produksi:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/side_by_side?schema=public"

# Konfigurasi Server Backend
PORT=3001
HOST="0.0.0.0"
SESSION_SECRET="side-by-side-dev-secret-change-in-production-32chars"
CORS_ORIGIN="http://localhost:5173"

# Konfigurasi Frontend Vite
VITE_API_URL="http://localhost:3001/api"
VITE_APP_NAME="Side by Side"

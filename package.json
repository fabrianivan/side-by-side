{
  "name": "side-by-side",
  "version": "0.1.0",
  "private": true,
  "description": "Side by Side — Better together. Aplikasi web kesehatan reproduksi pria yang mengutamakan privasi, tanpa penghakiman, dan pendampingan bersama pasangan.",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n \"API,WEB\" -c \"teal,blue\" \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "vite --port 5173",
    "dev:server": "tsx watch server/index.ts",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:setup": "prisma generate && prisma db push && tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^10.0.2",
    "@fastify/helmet": "^13.0.1",
    "@fastify/rate-limit": "^10.2.1",
    "@prisma/client": "^6.4.1",
    "@tanstack/react-query": "^5.66.0",
    "clsx": "^2.1.1",
    "fastify": "^5.2.1",
    "lucide-react": "^0.475.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.2.0",
    "tailwind-merge": "^3.0.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "jsdom": "^26.0.0",
    "postcss": "^8.5.3",
    "prisma": "^6.4.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.3",
    "typescript": "~5.7.2",
    "vite": "^6.1.1",
    "vitest": "^4.1.11"
  }
}
